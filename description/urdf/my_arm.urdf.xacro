<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_arm">

  <!-- === Includes === -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/ur_to_robotiq_adapter.urdf.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro"/>
  <xacro:include filename="$(find my_arm_bringup)/description/ros2_control/ur5.ros2_control.xacro"/>

  <!-- world root -->
  <link name="world"/>

  <!-- === UR5 arm === -->
  <xacro:ur_robot
    name="ur5"
    tf_prefix=""
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/ur5/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur5/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur5/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur5/visual_parameters.yaml">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- === Adapter: UR5 tool0 -> gripper mount frame === -->
  <xacro:ur_to_robotiq
    prefix=""
    parent="tool0"
    child="gripper_mount_link"/>

  <!-- === Robotiq 2F-85 gripper === -->
  <xacro:robotiq_gripper
    name="robotiq_gripper"
    prefix=""
    parent="gripper_mount_link"
    sim_gazebo="true"
    include_ros2_control="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_gripper>

  <!-- === ros2_control block for the UR5's 6 joints (Gazebo) === -->
  <xacro:ur5_ros2_control name="MyUR5System"/>

</robot>